# For Cloudflare local development, copy this to .dev.vars.
# Use a separate GitHub OAuth app for localhost; never reuse production secrets.
APP_ORIGIN=http://localhost:3007
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_HANDLES=
# Optional. The existing default is https://webshot.site/api/capture.
# Custom capture services must isolate private networks, redirects and subresources.
SCREENSHOT_API_URL=
SCREENSHOT_API_TOKEN=
